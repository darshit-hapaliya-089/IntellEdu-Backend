{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./build",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "#controllers/*": [
        "./app/controllers/*.js"
      ],
      "#middleware/*": [
        "./app/middleware/*.js"
      ],
      "#models/*": [
        "./app/models/*.js"
      ],
      "#validators/*": [
        "./app/validators/*.js"
      ],
      "#services/*": [
        "./app/services/*.js"
      ],
      "#exceptions/*": [
        "./app/exceptions/*.js"
      ],
      "#config/*": [
        "./config/*.js"
      ],
      "#database/*": [
        "./database/*.js"
      ],
      "#start/*": [
        "./start/*.js"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "build",
    "node_modules"
  ]
}