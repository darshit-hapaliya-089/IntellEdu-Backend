{
  "name": "intelledu-backend",
  "version": "1.0.0",
  "description": "IntellEdu Backend API — AdonisJS v6 + PostgreSQL",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ace serve --hmr",
    "build": "node ace build",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "migration:run": "node ace migration:run",
    "migration:rollback": "node ace migration:rollback",
    "db:seed": "node ace db:seed"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#models/*": "./app/models/*.js",
    "#validators/*": "./app/validators/*.js",
    "#services/*": "./app/services/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#config/*": "./config/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.3.2",
    "@adonisjs/core": "^6.17.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.6.0",
    "@vinejs/vine": "^4.4.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "luxon": "^3.5.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.13.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@japa/api-client": "^3.0.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^3.0.1",
    "@japa/runner": "^3.1.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "hot-hook": "^0.2.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  }
}
