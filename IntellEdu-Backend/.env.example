NODE_ENV=development
PORT=3333
APP_KEY=
HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=5432
DB_DATABASE=IntellEdu

JWT_SECRET=generate-a-unique-jwt-secret
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Use the Firebase Web app API key from the same project as the frontend config.
FIREBASE_API_KEY=

# Twilio Programmable Messaging: use an SMS-enabled E.164 sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gmail: use smtp.gmail.com, port 465, and a Google App Password (not account password).
SMTP_HOST=intelledu.app@gmail.com
SMTP_PORT=465
SMTP_USER=intelledu.app@gmail.com
SMTP_PASS=