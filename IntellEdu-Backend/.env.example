NODE_ENV=development
PORT=3333
APP_KEY=generate-a-long-random-app-key
HOST=127.0.0.1
LOG_LEVEL=info

DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_DATABASE=your-database-name

JWT_SECRET=generate-a-long-random-jwt-secret
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
FIREBASE_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# Gmail: use smtp.gmail.com, port 465, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com

# Keep disabled in production. Enable only on a local machine.
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR=./storage/whatsapp-auth